# Lets the user logged in at the seat read keyboards and create a virtual
# keyboard, which osxd's hotkeys need. Must sort before 73-seat-late.rules,
# which turns the uaccess tag into file permissions.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
